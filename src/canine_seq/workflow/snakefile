# add reports html later
# split into multiple snakefiles later

configfile: "config/config.yaml"
RAW_DIR = config["run"]["raw_data_dir"]
THREADS = config["run"]["threads"]
SAMPLES = glob_wildcards(f'{RAW_DIR}/{{sample}}.cram').sample
print("Samples found:", SAMPLES)

rule all:
    input: 
        expand("resources/data/temp/{sample}.bam", sample=SAMPLES)

rule convert:
    input:
        cram=f"{RAW_DIR}/{{sample}}.cram",
    output:
        bam="resources/data/temp/{sample}.bam",
    log:
        "logs/convert/{sample}.log",
    threads: THREADS
    shell:
        """
        samtools view -b {input.cram} > {output.bam} --threads {threads} 2> {log}
        """


