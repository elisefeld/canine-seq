###########################
######### REPORT ##########
###########################
rule multiqc:
    input:
        flagstat=expand(f'{RESULTS_MAIN_DIR}/flagstat/pre_align/{{sample}}.txt', sample=SAMPLES),
        flagstat_aligned=expand(f'{RESULTS_MAIN_DIR}/flagstat/post_align/{{sample}}_aligned.txt', sample=SAMPLES),
        fastqc=expand(f'{RESULTS_MAIN_DIR}/fastqc/pre_trim/{{sample}}_{{read}}_fastqc.{{ext}}', sample=SAMPLES, read=['R1', 'R2'], ext=['html', 'zip']),
        fastqc_trimmed=expand(f'{RESULTS_MAIN_DIR}/fastqc/post_trim/{{sample}}_{{read}}_trimmed_fastqc.{{ext}}', sample=SAMPLES, read=['R1', 'R2'], ext=['html', 'zip']),
        featurecounts=f'{RESULTS_MAIN_DIR}/featurecounts/counts.txt'
        #kallisto=expand(f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv', sample=SAMPLES)
    output:
        html=f'{REPORT_MAIN_DIR}/multiqc_report.html'
    log:
        f'{LOGS_MAIN_DIR}/multiqc.log'
    params:
        fastqc_ignore=f'{LOGS_MAIN_DIR}/fastqc/pre_trim/*',
        flagstat_ignore=f'{RESULTS_MAIN_DIR}/flagstat/pre_align/*'
    shell:
        '''
        multiqc {RESULTS_MAIN_DIR} \
        {LOGS_MAIN_DIR} \
        --ignore {params.fastqc_ignore} \
        --ignore {params.flagstat_ignore} \
        -o {REPORT_MAIN_DIR} \
        &> {log}
        '''

rule multiqc_virus:
    input:
        fastqc=expand(f'{RESULTS_VIRUS_DIR}/fastqc/{{sample}}_{{read}}_fastqc.{{ext}}', sample=SAMPLES, read=['R1', 'R2'], ext=['html', 'zip']),
        counts=f'{RESULTS_VIRUS_DIR}/featurecounts/counts_viral.txt'
    output:
        html=f'{REPORT_VIRUS_DIR}/multiqc_virus_report.html'
    log:
        f'{LOGS_VIRUS_DIR}/multiqc_viral.log'
    shell:
        '''
        multiqc {RESULTS_VIRUS_DIR} \
        {LOGS_VIRUS_DIR} \
        -o {REPORT_VIRUS_DIR} \
        -n multiqc_viral_report.html
        &> {log}
        '''

