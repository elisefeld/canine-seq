configfile: "config/config.yaml"

PROJECT = config["project"]["name"]

ORGANISM = config["run"]["ref_organism"]
BUILD = config["run"]["ref_build"]
THREADS = config["run"]["threads"]

BASE_REF_DIR = config["path"]["reference_dir"]
BASE_DATA_DIR = config["path"]["raw_data_dir"]
BASE_RESULTS_DIR = config["path"]["results_dir"]
BASE_REPORT_DIR = config["path"]["report_dir"]
SAMPLE_SHEET = config["path"]["sample_sheet"]

CDNA_REF = config["reference"]["cdna"]

PROJECT_DATA_DIR = f"{BASE_DATA_DIR}/{PROJECT}"
SAMPLE_SHEET_PATH = f"{PROJECT_DATA_DIR}/{SAMPLE_SHEET}"
REF_DIR = f"{BASE_REF_DIR}/{ORGANISM}/{BUILD}"
RESULTS_DIR = f"{BASE_RESULTS_DIR}/{PROJECT}"
REPORT_DIR = f"{BASE_REPORT_DIR}/{PROJECT}"

SAMPLES = glob_wildcards(f'{PROJECT_DATA_DIR}/{{sample}}.cram').sample
print("Samples found:", SAMPLES)

rule all:
    input: 
        expand(f"{RESULTS_DIR}/qc/flagstat/{{sample}}.txt", sample=SAMPLES),
        expand(f"{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz", sample=SAMPLES),
        expand(f"{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz", sample=SAMPLES),
        expand(f"{RESULTS_DIR}/qc/fastqc/pre_{{sample}}_R1_fastqc.html", sample=SAMPLES),
        expand(f"{RESULTS_DIR}/qc/fastqc/pre_{{sample}}_R2_fastqc.html", sample=SAMPLES),
        expand(f"{RESULTS_DIR}/qc/fastp/{{sample}}_R1_trimmed.fastq.gz", sample=SAMPLES),
        expand(f"{RESULTS_DIR}/qc/fastp/{{sample}}_R2_trimmed.fastq.gz", sample=SAMPLES),
        #expand(f"{RESULTS_DIR}/qc/fastqc/post_{{sample}}_R1_fastqc.html", sample=SAMPLES),
        #expand(f"{RESULTS_DIR}/qc/fastqc/post_{{sample}}_R2_fastqc.html", sample=SAMPLES),
        f"{REF_DIR}/{ORGANISM}_{BUILD}.idx",
        expand(f"{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv", sample=SAMPLES),
        f"{REPORT_DIR}/multiqc_report.html"
        

###########################
## QUALITY CONTROL RULES ##
###########################
rule flagstat:
    input:
        cram=f"{PROJECT_DATA_DIR}/{{sample}}.cram",
    output:
        flagstat=f"{RESULTS_DIR}/qc/flagstat/{{sample}}.txt"
    #conda: 
    #    "../config/env.yaml"
    shell:
        """
        echo "Running samtools flagstat on {input.cram}..."
        samtools flagstat {input.cram} > {output.flagstat}
        """

rule extract_fastq:
    input:
        cram=f"{PROJECT_DATA_DIR}/{{sample}}.cram",
    output:
        fastq1=f"{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz",
        fastq2=f"{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz",
    #conda: 
    #    "../config/env.yaml"
    shell:
        """
        echo "Extracting FASTQ files from {input.cram}..."
        samtools fastq -@ {THREADS} -1 {output.fastq1} -2 {output.fastq2} {input.cram}
        """

rule pre_fastqc:
    input:
        fastq1=f"{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz",
        fastq2=f"{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz"
    output:
        html1=f"{RESULTS_DIR}/qc/fastqc/pre_{{sample}}_R1_fastqc.html",
        html2=f"{RESULTS_DIR}/qc/fastqc/pre_{{sample}}_R2_fastqc.html"
    #conda: 
    #    "../config/env.yaml"
    shell:
        """
        fastqc -o {RESULTS_DIR}/qc/fastqc -t {THREADS} {input.fastq1} {input.fastq2}
        """

rule adapter_trim: #this step didn't do much so reads were probably already trimmed
    input:
        fastq1=f"{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz",
        fastq2=f"{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz"
    output:
        trimmed_fastq1=f"{RESULTS_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz",
        trimmed_fastq2=f"{RESULTS_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz",
        html_report=f"{RESULTS_DIR}/fastp/{{sample}}.html"
    #conda: 
    #    "../config/env.yaml"
    shell:
        """
        fastp trim -V -o {output.trimmed_fastq1} -O {output.trimmed_fastq2} -i {input.fastq1} -I {input.fastq2} -h {output.html_report}
        """

