configfile: "config/config.yaml"

PROJECT = config["project"]["name"]

ORGANISM = config["run"]["ref_organism"]
BUILD = config["run"]["ref_build"]
THREADS = config["run"]["threads"]

BASE_REF_DIR = config["path"]["reference_dir"]
BASE_DATA_DIR = config["path"]["raw_data_dir"]
BASE_RESULTS_DIR = config["path"]["results_dir"]
SAMPLE_SHEET = config["path"]["sample_sheet"]

MRNA_REF = config["reference"]["mrna"]

PROJECT_DATA_DIR = f"{BASE_DATA_DIR}/{PROJECT}"
SAMPLE_SHEET_PATH = f"{PROJECT_DATA_DIR}/{SAMPLE_SHEET}"
REF_DIR = f"{BASE_REF_DIR}/{ORGANISM}/{BUILD}"
RESULTS_DIR = f"{BASE_RESULTS_DIR}/{PROJECT}"

SAMPLES = glob_wildcards(f'{PROJECT_DATA_DIR}/{{sample}}.cram').sample
print("Samples found:", SAMPLES)

rule all:
    input: 
        f"{REF_DIR}/refseq.mrna.idx",
        expand(f"{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz", sample=SAMPLES),
        expand(f"{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz", sample=SAMPLES),
        expand(f"{RESULTS_DIR}/qc/fastqc/{{sample}}_R1_fastqc.html", sample=SAMPLES),
        expand(f"{RESULTS_DIR}/qc/fastqc/{{sample}}_R2_fastqc.html", sample=SAMPLES),
        expand(f"{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv", sample=SAMPLES)



###########################
## QUALITY CONTROL RULES ##
###########################
rule flagstat:
    input:
        cram=f"{PROJECT_DATA_DIR}/{{sample}}.cram",
    output:
        flagstat=f"{RESULTS_DIR}/qc/flagstat/{{sample}}.txt"
    #conda: 
    #    "../config/env.yaml"
    shell:
        """
        echo "Running samtools flagstat on {input.cram}..."
        samtools flagstat {input.cram} > {output.flagstat}
        """

rule extract_fastq:
    input:
        cram=f"{PROJECT_DATA_DIR}/{{sample}}.cram",
    output:
        fastq1=f"{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz",
        fastq2=f"{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz",
    #conda: 
    #    "../config/env.yaml"
    shell:
        """
        echo "Extracting FASTQ files from {input.cram}..."
        samtools fastq -@ {THREADS} -1 {output.fastq1} -2 {output.fastq2} {input.cram}
        """

rule adapter_trim:
    input:
        fastq1=f"{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz",
        fastq2=f"{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz"
    output:
        trimmed_fastq1=f"{RESULTS_DIR}/fastq/{{sample}}_R1.trimmed.fastq.gz",
        trimmed_fastq2=f"{RESULTS_DIR}/fastq/{{sample}}_R2.trimmed.fastq.gz"
    #conda: 
    #    "../config/env.yaml"
    shell:
        """
        """

rule fastqc:
    input:
        fastq1=f"{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz",
        fastq2=f"{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz"
    output:
        html1=f"{RESULTS_DIR}/qc/fastqc/{{sample}}_R1_fastqc.html",
        html2=f"{RESULTS_DIR}/qc/fastqc/{{sample}}_R2_fastqc.html"
    #conda: 
    #    "../config/env.yaml"
    shell:
        """
        fastqc -o {RESULTS_DIR}/qc/fastqc -t {THREADS} {input.fastq1} {input.fastq2}
        """

# multiqc

