import os
import sys
import errno
import pandas as pd

###########################
###### CONFIGURATION ######
###########################
configfile: 'config/config.yaml'

PROJECT = config['project']['name']
SPECIES = config['run']['ref_species']
BUILD = config['run']['ref_build']
RELEASE = config['run']['ref_release']

# Directory declaration and creation
DATA_DIR = os.path.join(config['path']['data_dir'], PROJECT) 
REF_DIR = os.path.join(config['path']['data_dir'], config['path']['reference_dir'], f'{SPECIES}_{BUILD}_{RELEASE}')

RUN_DIR = os.path.join(config['path']['run_dir'], config['run']['run_name'])
RESULTS_DIR = os.path.join(RUN_DIR, config['path']['results_dir'])
REPORT_DIR = os.path.join(RUN_DIR, config['path']['report_dir'])
LOGS_DIR = os.path.join(RUN_DIR, config['path']['log_dir'])

dirs = [DATA_DIR, REF_DIR, RESULTS_DIR, REPORT_DIR, LOGS_DIR]
for directory in dirs:
    os.makedirs(directory,exist_ok=True)
    print(f'Project directory \'{directory}\' created successfully', file=sys.stderr)

FASTA = os.path.join(REF_DIR, config['ref']['fasta'])
GTF   = os.path.join(REF_DIR, config['ref']['gtf'])
CDNA  = os.path.join(REF_DIR, config['ref']['cdna'])
CRAM = os.path.join(DATA_DIR, '{sample}.cram')

FASTQ_R1 = os.path.join(RESULTS_DIR, 'fastq', '{sample}_R1.fastq.gz')
FASTQ_R2 = os.path.join(RESULTS_DIR, 'fastq', '{sample}_R2.fastq.gz')

TRIM_R1 = os.path.join(RESULTS_DIR, 'fastp', '{sample}_R1_trimmed.fastq.gz')
TRIM_R2 = os.path.join(RESULTS_DIR, 'fastp', '{sample}_R2_trimmed.fastq.gz')

SORTED_CRAM = os.path.join(RESULTS_DIR, 'sort', '{sample}.cram')
SAM = os.path.join(RESULTS_DIR, 'hisat2', '{sample}.sam')
SORTED_BAM = os.path.join(RESULTS_DIR, 'bam', '{sample}_sorted.bam')
BAI = f'{SORTED_BAM}.bai'

# File declaration and checks
SAMPLE_SHEET = os.path.join(DATA_DIR, config['run']['sample_sheet'])
if os.path.exists(SAMPLE_SHEET):
    print(f'File \'{SAMPLE_SHEET}\' located successfully', file=sys.stderr)
else:
    raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), SAMPLE_SHEET)
         
# Identifying samples from sample sheet and data directory
samples_df = pd.read_csv(SAMPLE_SHEET, sep = ',')
sample_sheet = samples_df['sample_id'].tolist()
sample_data = glob_wildcards(f'{DATA_DIR}/{{sample}}.cram').sample

if len(sample_sheet) > 0:
    print(f'{len(sample_sheet)} samples found in sample sheet ({SAMPLE_SHEET}):', file=sys.stderr)
    for sample in sample_sheet:
        print(f'- {sample}', file=sys.stderr)
else:
    raise ValueError(f'No samples found in sample sheet ({SAMPLE_SHEET})')

if len(sample_data) > 0:
    print(f'{len(sample_data)} samples found in data directory ({DATA_DIR}):', file=sys.stderr)
    for sample in sample_data:
        print(f'- {sample}', file=sys.stderr)
else:
    raise ValueError('No samples found in sample sheet')

SAMPLES = (set(sample_sheet) & set(sample_data)) # samples present in both locations
MISSING = sorted(set(sample_sheet) - set(sample_data)) # samples listed in sample sheet but missing from data directory

if MISSING:
    print(f'WARNING: {len(MISSING)} samples from the sample sheet ({SAMPLE_SHEET} were not found in data directory ({DATA_DIR}):', file=sys.stderr)
    for sample in MISSING:
        print(f'- {sample}', file=sys.stderr)

print(f'Found {len(SAMPLES)} valid samples:', file=sys.stderr)
for sample in SAMPLES:
        print(f'- {sample}', file=sys.stderr)

print(f'Running analysis of {len(SAMPLES)} RNA-seq samples for {PROJECT} project. \nSpecies: {SPECIES} \nBuild: {BUILD} \nRelease: {RELEASE}', file=sys.stderr)

# Declaring desired outputs for the pipeline
rule all:
    input: 
        report=f'{REPORT_DIR}/multiqc_report.html'

###########################
##### QUALITY CONTROL #####
###########################
rule flagstat:
    input: 
        cram=CRAM
    output: 
        txt=f'{RESULTS_DIR}/flagstat/{{sample}}.txt'
    shell:
        '''
        echo 'Running samtools flagstat on {input.cram}...'
        samtools flagstat {input.cram} > {output.txt}
        '''

rule sort_cram:
    input:
        cram=CRAM
    output:
        sorted_cram=temp(SORTED_CRAM)
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools/{{sample}}_sort.log'
    shell:
        '''
        echo 'Sorting {input.cram} by name...'
        samtools sort -n \
        -@ {threads} \
        -o {output.sorted_cram} \
        {input.cram} \
        &> {log}
        '''

rule cram_to_fastq:
    input: 
        sorted_cram=SORTED_CRAM,
    output:
        read1=temp(FASTQ_R1),
        read2=temp(FASTQ_R2)
    threads: 
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/fastq/{{sample}}_fastq.log'
    shell:
        '''
        echo 'Extracting FASTQ files from {input.sorted_cram}...'
        samtools fastq \
        -@ {threads} \
        -1 {output.read1} \
        -2 {output.read2} \
        {input.sorted_cram} \
        &> {log}
        '''

rule fastqc:
    input:
        read1=FASTQ_R1,
        read2=FASTQ_R2
    output:
        R1=multiext(f'{RESULTS_DIR}/fastqc/{{sample}}_R1_fastqc','.html','.zip'),
        R2=multiext(f'{RESULTS_DIR}/fastqc/{{sample}}_R2_fastqc','.html','.zip')
    threads:
        config['threads']['fastqc']
    log:
        f'{LOGS_DIR}/fastqc/{{sample}}_fastqc.log'
    shell:
        '''
        echo 'Running a quality control report for {input.read1} and {input.read2}...'
        fastqc -o {RESULTS_DIR}/fastqc \
         -t {threads} \
         {input.read1} \
         {input.read2} \
         &> {log}
        '''

rule fastp_trim:
    input:
        read1=FASTQ_R1,
        read2=FASTQ_R2
    output:
        trimmed_read1=TRIM_R1,
        trimmed_read2=TRIM_R2,
        fastp=multiext(f'{RESULTS_DIR}/fastp/{{sample}}','.html','.json')
    threads:
        config['threads']['fastp']
    log:
        f'{LOGS_DIR}/fastp/{{sample}}_fastp.log'
    shell:
        '''
        echo 'Trimming reads for {input.read1} and {input.read2}...'
        fastp -V \
        --thread {threads} \
         -o {output.trimmed_read1} \
         -O {output.trimmed_read2} \
         -i {input.read1} \
         -I {input.read2} \
         &> {log}
        '''

rule fastqc_trimmed:
    input:
        read1=TRIM_R1,
        read2=TRIM_R2
    output:
        R1=multiext(f'{RESULTS_DIR}/fastqc/{{sample}}_R1_fastqc_trimmed','.html','.zip'),
        R2=multiext(f'{RESULTS_DIR}/fastqc/{{sample}}_R2_fastqc_trimmed','.html','.zip')
    threads:
        config['threads']['fastqc']
    log:
        f'{LOGS_DIR}/fastqc/{{sample}}_fastqc_trimmed.log'
    shell:
        '''
        echo 'Running a quality control report for {input.read1} and {input.read2}...'
        fastqc -o {RESULTS_DIR}/fastqc \
         -t {threads} \
         {input.read1} \
         {input.read2} \
         &> {log}
        '''

###########################
##### PSEUDOALIGNMENT #####
###########################
rule kallisto_index:
    input: 
        cdna=CDNA
    output: 
        idx=f'{CDNA}.idx'
    threads:
        config['threads']['kallisto']
    log:
        f'{LOGS_DIR}/kallisto/index.log'
    shell:
        '''
        echo 'Building kallisto index for {input.cdna}...'
        kallisto index -i {output.idx} \
         {input.cdna} \
         -t {threads} \
         &> {log}
        '''

rule kallisto_quant:
    input:
        idx=f'{CDNA}.idx',
        trimmed_read1=TRIM_R1,
        trimmed_read2=TRIM_R2,
    output:
        abundance=multiext(f'{RESULTS_DIR}/kallisto/{{sample}}/abundance','.tsv','.h5'),
        json=f'{RESULTS_DIR}/kallisto/{{sample}}/run_info.json'
    params:
        out_dir=f'{RESULTS_DIR}/kallisto/{{sample}}'
    log: 
        f'{LOGS_DIR}/kallisto/{{sample}}_quant.log'
    threads:
        config['threads']['kallisto']
    shell:
        '''
        echo 'Running kallisto pseudoalignment for {input.trimmed_read1} and {input.trimmed_read2}'
        kallisto quant -i {input.idx} \
         -o {params.out_dir} \
         -t {threads} \
         {input.trimmed_read1} \
         {input.trimmed_read2} \
         &> {log}
        '''


###########################
######## ALIGNMENT ########
###########################
rule hisat2_index:
    input: 
        fasta=FASTA
    output: 
        multiext(
            FASTA,
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2')
    threads:
        config['threads']['hisat2']
    params:
        index_base=f'{FASTA}'
    log:
        f'{LOGS_DIR}/hisat2/index.log'
    shell:
        '''
        echo 'Building hisat2 index for {input.fasta}...'
        hisat2-build  --threads {threads} \
        {input.fasta} \
        {params.index_base} \
        &> {log}
        '''

rule hisat2_align:
    input:
        multiext(
            FASTA,
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2'),
        trimmed_read1=TRIM_R1,
        trimmed_read2=TRIM_R2,
    threads:
        config['threads']['hisat2']
    output:
        sam=temp(SAM)
    log:
        f'{LOGS_DIR}/hisat2/{{sample}}_align.log'
    params:
        index_base=f'{FASTA}'
    shell:
        '''
        echo 'Running HISAT2 alignment for {input.trimmed_read1} and {input.trimmed_read2}'
        hisat2 -x {params.index_base} \
        --threads {threads} \
        -1 {input.trimmed_read1} \
        -2 {input.trimmed_read2} \
        -S {output.sam} \
        &> {log}
        '''

rule sort_bam:
    input:
        sam=SAM
    output:
        sorted_bam=SORTED_BAM
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools/{{sample}}_sortbam.log'
    shell:
        '''
        echo 'Sorting {input.sam} by name...'
        samtools sort -n \
        -@ {threads} \
        {input.sam} \
        -o {output.sorted_bam} \
        &> {log}
        '''

rule index_bam:
    input:
        sorted_bam=SORTED_BAM
    output:
        bai=BAI
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools/{{sample}}_indexbam.log'
    shell:
        '''
        echo 'Creating index for {input.sorted_bam}...'
        samtools index \
        -@ {threads} \
        {input.sorted_bam} \
        &> {log}
        '''

rule flagstat_aligned:
    input: 
        sorted_bam=SORTED_BAM
    output: 
        txt=f'{RESULTS_DIR}/flagstat/{{sample}}_aligned.txt'
    shell:
        '''
        echo 'Running samtools flagstat on {input.sorted_bam}...'
        samtools flagstat {input.sorted_bam} > {output.txt}
        '''

rule feature_counts:
    input:
        bam=SORTED_BAM,
        bai=BAI,
        gtf=GTF
    output:
        counts=f'{RESULTS_DIR}/featurecounts/{{sample}}_counts.txt'
    threads:
        config['threads']['featurecounts']
    log:
        f'{LOGS_DIR}/featurecounts/{{sample}}_featurecounts.log'
    shell:
        '''
        echo 'Running featureCounts for {input.bam}...'
        featureCounts -p \
        -g gene_id \
        -a {input.gtf} \
        -o {output.counts} \
        -T {threads} \
        {input.bam} \
        &> {log}
        '''

###########################
######### REPORT ##########
###########################
rule multiqc:
    input:
        flagstat=expand(f'{RESULTS_DIR}/flagstat/{{sample}}.txt', sample=SAMPLES),
        flagstat_aligned=expand(f'{RESULTS_DIR}/flagstat/{{sample}}_aligned.txt', sample=SAMPLES),
        fastqc=expand(f'{RESULTS_DIR}/fastqc/{{sample}}_{{read}}_fastqc.{{ext}}', sample=SAMPLES, read=['R1', 'R2'], ext=['html', 'zip']),
        fastqc_trimmed=expand(f'{RESULTS_DIR}/fastqc/{{sample}}_{{read}}_fastqc_trimmed.{{ext}}', sample=SAMPLES, read=['R1', 'R2'], ext=['html', 'zip']),
        featurecounts=expand(f'{RESULTS_DIR}/featurecounts/{{sample}}_counts.txt', sample=SAMPLES)
        #kallisto=expand(f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv', sample=SAMPLES)
    output:
        html=f'{REPORT_DIR}/multiqc_report.html'
    log:
        f'{LOGS_DIR}/multiqc.log'
    shell:
        '''
        multiqc {DATA_DIR} \
        {RESULTS_DIR} \
        {LOGS_DIR} \
        -o {REPORT_DIR} \
        &> {log}
        '''