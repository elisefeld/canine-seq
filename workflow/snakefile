rule align_virus:
    input: 
        multiext(
            VIRUS_FASTA,
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2'),
        R1=f'{RESULTS_VIRUS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{RESULTS_VIRUS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        sam=temp(f'{RESULTS_VIRUS_DIR}/hisat2/{{sample}}_virus_aligned.sam')
    threads:
        config['threads']['hisat2']
    log:
        f'{LOGS_VIRUS_DIR}/hisat2/{{sample}}_align_virus.log'
    params:
        index_base=VIRUS_FASTA
    shell:
        '''
        echo 'Aligning reads from {input.R1} and {input.R2} to viral reference...'
        hisat2 -x {params.index_base} \
        --threads {threads} \
        -1 {input.R1} \
        -2 {input.R2} \
        -S {output.sam} \
        &> {log}
        '''

