import os
import sys
import errno
import pandas as pd

###########################
###### CONFIGURATION ######
###########################
configfile: 'config/config.yaml' # loads user defined settings from config.yaml

PROJECT = config['project']['name'] # name of the project used to find the correct data folder

# Directory declaration and creation
PROJ_DATA_DIR = os.path.join('data', PROJECT) # this directory should contain .cram and .crai files and the sample sheet.
MAIN_REF_DIR = os.path.join('data', 'reference', config['ref']['main']['name']) # should contain fasta and gtf for main species
VIRUS_REF_DIR = os.path.join('data', 'reference', config['ref']['virus']['name']) # should contain fasta and gtf for virus

RUN_DIR = os.path.join('runs', config['run']['run_name'])

RESULTS_MAIN_DIR = os.path.join(RUN_DIR, 'results', 'main')
RESULTS_VIRUS_DIR = os.path.join(RUN_DIR, 'results', 'virus')

REPORT_MAIN_DIR = os.path.join(RUN_DIR, 'report', 'main')
REPORT_VIRUS_DIR = os.path.join(RUN_DIR, 'report', 'virus')

IGV_MAIN_DIR = os.path.join(RUN_DIR, 'igv', 'main')
IGV_VIRUS_DIR = os.path.join(RUN_DIR, 'igv', 'virus')

LOGS_MAIN_DIR = os.path.join(RUN_DIR, 'logs', 'main')
LOGS_VIRUS_DIR = os.path.join(RUN_DIR, 'logs', 'virus')


# Creation of main directories if they do not exist
dirs = [RUN_DIR, RESULTS_MAIN_DIR, RESULTS_VIRUS_DIR, REPORT_MAIN_DIR, REPORT_VIRUS_DIR, IGV_MAIN_DIR, IGV_VIRUS_DIR, LOGS_MAIN_DIR, LOGS_VIRUS_DIR]
for directory in dirs:
    os.makedirs(directory,exist_ok=True)
    print(f'Project directory \'{directory}\' created successfully', file=sys.stderr)

# Reference files for main species
MAIN_FASTA = os.path.join(MAIN_REF_DIR, config['ref']['main']['fasta'])
MAIN_GTF   = os.path.join(MAIN_REF_DIR, config['ref']['main']['gtf'])

# Reference files for virus
VIRUS_FASTA = os.path.join(VIRUS_REF_DIR, config['ref']['virus']['fasta'])
VIRUS_GTF   = os.path.join(VIRUS_REF_DIR, config['ref']['virus']['gtf'])

# Sample sheet verification (checking if sample sheet exists in correct directory)
SAMPLE_SHEET = os.path.join(PROJ_DATA_DIR, config['run']['sample_sheet'])
if os.path.exists(SAMPLE_SHEET): 
    print(f'File \'{SAMPLE_SHEET}\' located successfully', file=sys.stderr) 
else:
    raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), SAMPLE_SHEET)
         
# Checking if sample sheet actually has rows with sample information
samples_df = pd.read_csv(SAMPLE_SHEET, sep = ',') 
sample_sheet = samples_df['sample_id'].tolist() # creates list of sample ids in sample sheet. sample sheet MUST have a 'sample_id' column

if len(sample_sheet) > 0:
    print(f'{len(sample_sheet)} samples found in sample sheet ({SAMPLE_SHEET}):', file=sys.stderr)
    for sample in sample_sheet:
        print(f'- {sample}', file=sys.stderr)
else:
    raise ValueError(f'No samples found in sample sheet ({SAMPLE_SHEET})')

# Checking if cram files exist in the data directory
sample_data = glob_wildcards(f'{PROJ_DATA_DIR}/{{sample}}.cram').sample # grabs file names that have a cram extension

if len(sample_data) > 0:
    print(f'{len(sample_data)} samples found in data directory ({PROJ_DATA_DIR}):', file=sys.stderr)
    for sample in sample_data:
        print(f'- {sample}', file=sys.stderr)
else:
    raise ValueError(f'No samples found in data directory ({PROJ_DATA_DIR})')

# Checking if samples in data directory and sample sheet match
SAMPLES = (set(sample_sheet) & set(sample_data)) # samples present in both locations
MISSING = sorted(set(sample_sheet) - set(sample_data)) # samples listed in sample sheet but missing from data directory

if MISSING:
    print(f'WARNING: {len(MISSING)} samples from the sample sheet ({SAMPLE_SHEET}) were not found in data directory ({PROJ_DATA_DIR}):', file=sys.stderr)
    for sample in MISSING:
        print(f'- {sample}', file=sys.stderr)

print(f'Found {len(SAMPLES)} valid samples:', file=sys.stderr)
for sample in SAMPLES:
        print(f'- {sample}', file=sys.stderr)

print(f'Running analysis of {len(SAMPLES)} RNA-seq samples for {PROJECT} project.' , file=sys.stderr)




# Declaring desired outputs for the pipeline
rule all:
    input: 
        main_report=f'{REPORT_MAIN_DIR}/multiqc_report.html',
        virus_report=f'{REPORT_VIRUS_DIR}/multiqc_virus_report.html',
        coord_sorted_bams=expand(f'{IGV_MAIN_DIR}/{{sample}}_coord_sorted.bam', sample=SAMPLES),
        bam_indices=expand(f'{IGV_MAIN_DIR}/{{sample}}_coord_sorted.bam.bai', sample=SAMPLES),
        unmapped_bam=expand(f'{RESULTS_VIRUS_DIR}/unmapped/{{sample}}_unmapped.bam', sample=SAMPLES),
        fastqc_viral_R1=expand(f'{RESULTS_VIRUS_DIR}/fastqc/{{sample}}_R1_fastqc.html', sample=SAMPLES),
        fastqc_viral_R2=expand(f'{RESULTS_VIRUS_DIR}/fastqc/{{sample}}_R2_fastqc.html', sample=SAMPLES),

###########################
##### QUALITY CONTROL #####
###########################
rule flagstat:
    input: 
        cram=f'{PROJ_DATA_DIR}/{{sample}}.cram'
    output: 
        txt=f'{RESULTS_MAIN_DIR}/flagstat/pre_align/{{sample}}.txt'
    shell:
        '''
        echo 'Running samtools flagstat on {input.cram}...'
        samtools flagstat {input.cram} > {output.txt}
        '''

rule name_sort_cram:
    input:
        cram=f'{PROJ_DATA_DIR}/{{sample}}.cram'
    output:
        sorted_cram=temp(f'{RESULTS_MAIN_DIR}/sort/{{sample}}.cram')
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_MAIN_DIR}/samtools/name_sort/{{sample}}_name_sort_cram.log'
    shell:
        '''
        echo 'Sorting {input.cram} by name...'
        samtools sort -n \
        -@ {threads} \
        -o {output.sorted_cram} \
        {input.cram} \
        &> {log}
        '''

rule cram_to_fastq:
    input: 
        sorted_cram=f'{RESULTS_MAIN_DIR}/sort/{{sample}}.cram',
    output:
        R1=f'{RESULTS_MAIN_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{RESULTS_MAIN_DIR}/fastq/{{sample}}_R2.fastq.gz'
    threads: 
        config['threads']['samtools']
    log:
        f'{LOGS_MAIN_DIR}/samtools/fastq/{{sample}}_cram_to_fastq.log'
    shell:
        '''
        echo 'Extracting FASTQ files from {input.sorted_cram}...'
        samtools fastq \
        -@ {threads} \
        -1 {output.R1} \
        -2 {output.R2} \
        {input.sorted_cram} \
        &> {log}
        '''

rule fastqc:
    input:
        R1=f'{RESULTS_MAIN_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{RESULTS_MAIN_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        R1=multiext(f'{RESULTS_MAIN_DIR}/fastqc/pre_trim/{{sample}}_R1_fastqc','.html','.zip'),
        R2=multiext(f'{RESULTS_MAIN_DIR}/fastqc/pre_trim/{{sample}}_R2_fastqc','.html','.zip')
    threads:
        config['threads']['fastqc']
    log:
        f'{LOGS_MAIN_DIR}/fastqc/pre_trim/{{sample}}_fastqc.log'
    params:
        out_dir=f'{RESULTS_MAIN_DIR}/fastqc/pre_trim'
    shell:
        '''
        echo 'Running a quality control report for {input.R1} and {input.R2}...'
        fastqc -o {params.out_dir} \
         -t {threads} \
         {input.R1} \
         {input.R2} \
         &> {log}
        '''

rule fastp_trim:
    input:
        R1=f'{RESULTS_MAIN_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{RESULTS_MAIN_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        trimmed_R1=f'{RESULTS_MAIN_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz',
        trimmed_R2=f'{RESULTS_MAIN_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz',
        html=f'{RESULTS_MAIN_DIR}/fastp/{{sample}}.html',
        json=f'{RESULTS_MAIN_DIR}/fastp/{{sample}}.json'
    threads:
        config['threads']['fastp']
    log:
        f'{LOGS_MAIN_DIR}/fastp/{{sample}}_fastp_trim.log'
    shell:
        '''
        echo 'Trimming reads for {input.R1} and {input.R2}...'
        fastp -V \
        --thread {threads} \
         -o {output.trimmed_R1} \
         -O {output.trimmed_R2} \
         -i {input.R1} \
         -I {input.R2} \
         --detect_adapter_for_pe \
         -h {output.html} \
         -j {output.json} \
         &> {log}
        '''

rule fastqc_trimmed:
    input:
        R1=f'{RESULTS_MAIN_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz',
        R2=f'{RESULTS_MAIN_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz'
    output:
        R1=multiext(f'{RESULTS_MAIN_DIR}/fastqc/post_trim/{{sample}}_R1_trimmed_fastqc','.html','.zip'),
        R2=multiext(f'{RESULTS_MAIN_DIR}/fastqc/post_trim/{{sample}}_R2_trimmed_fastqc','.html','.zip')
    threads:
        config['threads']['fastqc']
    log:
        f'{LOGS_MAIN_DIR}/fastqc/post_trim/{{sample}}_fastqc_trimmed.log'
    params:
        out_dir=f'{RESULTS_MAIN_DIR}/fastqc/post_trim'
    shell:
        '''
        echo 'Running a quality control report for {input.R1} and {input.R2}...'
        fastqc -o {params.out_dir} \
         -t {threads} \
         {input.R1} \
         {input.R2} \
         &> {log}
        '''

###########################
######## ALIGNMENT ########
###########################
rule hisat2_index:
    input: 
        fasta=MAIN_FASTA
    output: 
        multiext(
            MAIN_FASTA,
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2')
    threads:
        config['threads']['hisat2']
    params:
        index_base=MAIN_FASTA
    log:
        f'{LOGS_MAIN_DIR}/hisat2/hisat2_index.log'
    shell:
        '''
        echo 'Building hisat2 index for {input.fasta}...'
        hisat2-build  --threads {threads} \
        {input.fasta} \
        {params.index_base} \
        &> {log}
        '''

rule hisat2_align:
    input:
        multiext(
            MAIN_FASTA,
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2'),
        trimmed_R1=f'{RESULTS_MAIN_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz',
        trimmed_R2=f'{RESULTS_MAIN_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz',
    threads:
        config['threads']['hisat2']
    output:
        sam=temp(f'{RESULTS_MAIN_DIR}/hisat2/{{sample}}.sam')
    log:
        f'{LOGS_MAIN_DIR}/hisat2/{{sample}}_hisat2_align.log'
    params:
        index_base=f'{MAIN_FASTA}'
    shell:
        '''
        echo 'Running HISAT2 alignment for {input.trimmed_R1} and {input.trimmed_R2}'
        hisat2 -x {params.index_base} \
        --threads {threads} \
        -1 {input.trimmed_R1} \
        -2 {input.trimmed_R2} \
        -S {output.sam} \
        &> {log}
        '''

rule name_sort_bam:
    input:
        sam=f'{RESULTS_MAIN_DIR}/hisat2/{{sample}}.sam'
    output:
        sorted_bam=f'{RESULTS_MAIN_DIR}/sort/{{sample}}_sorted.bam'
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_MAIN_DIR}/samtools/name_sort/{{sample}}_name_sort_bam.log'
    shell:
        '''
        echo 'Sorting {input.sam} by name...'
        samtools sort -n \
        -@ {threads} \
        {input.sam} \
        -o {output.sorted_bam} \
        &> {log}
        '''

rule flagstat_aligned:
    input: 
        sorted_bam=f'{RESULTS_MAIN_DIR}/sort/{{sample}}_sorted.bam'
    output: 
        txt=f'{RESULTS_MAIN_DIR}/flagstat/post_align/{{sample}}_aligned.txt'
    shell:
        '''
        echo 'Running samtools flagstat on {input.sorted_bam}...'
        samtools flagstat {input.sorted_bam} > {output.txt}
        '''

rule feature_counts:
    input:
        bams=expand(f'{RESULTS_MAIN_DIR}/sort/{{sample}}_sorted.bam', sample=SAMPLES),
        gtf=MAIN_GTF
    output:
        counts=f'{RESULTS_MAIN_DIR}/featurecounts/counts.txt'
    threads:
        config['threads']['featurecounts']
    log:
        f'{LOGS_MAIN_DIR}/featurecounts/featurecounts.log'
    shell:
        '''
        echo 'Running featureCounts for {input.bams}...'
        featureCounts -p \
        -g gene_id \
        -a {input.gtf} \
        -o {output.counts} \
        -T {threads} \
        {input.bams} \
        &> {log}
        '''

###########################
########### IGV ###########
###########################
rule coord_sort_bam:
    input:
        bam=f'{RESULTS_MAIN_DIR}/sort/{{sample}}_sorted.bam'
    output:
        sorted_bam=f'{IGV_MAIN_DIR}/{{sample}}_coord_sorted.bam'
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_MAIN_DIR}/samtools/coord_sort/{{sample}}/coord_sort_bam.log'
    shell:
        '''
        echo 'Sorting {input.bam} by coordinate...'
        samtools sort -@ {threads} \
        -o {output.sorted_bam} \
        {input.bam} \
        &> {log}
        '''

rule index_bam:
    input:
        bam=f'{IGV_MAIN_DIR}/{{sample}}_coord_sorted.bam'
    output:
        bai=f'{IGV_MAIN_DIR}/{{sample}}_coord_sorted.bam.bai'
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_MAIN_DIR}/samtools/index/{{sample}}_index_bam.log'
    shell:
        '''
        echo 'Indexing {input.bam}...'
        samtools index -@ {threads} \
        {input.bam} \
        &> {log}
        '''

###########################
##### VIRAL DETECTION #####
###########################
rule extract_unmapped_reads:
    input:
        bam=f'{RESULTS_MAIN_DIR}/sort/{{sample}}_sorted.bam'
    output:
        unmapped_bam=f'{RESULTS_VIRUS_DIR}/unmapped/{{sample}}_unmapped.bam'
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_VIRUS_DIR}/samtools/extract/{{sample}}_extract_unmapped_reads.log'
    shell:
        '''
        echo 'Extracting unmapped reads from {input.bam}...'
        samtools view -b -h -f 12 \
        {input.bam} \
        -o {output.unmapped_bam} \
        -@ {threads} \
        &> {log}
        '''

rule name_sort_unmapped_virus_bam:
    input:
        bam=f'{RESULTS_VIRUS_DIR}/unmapped/{{sample}}_unmapped.bam'
    output:
        sorted_bam=temp(f'{RESULTS_VIRUS_DIR}/sort/{{sample}}_sorted.bam')
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_VIRUS_DIR}/samtools/sort/name_sort/{{sample}}name_sort_unmapped_virus_bam.log'
    shell:
        '''
        echo 'Sorting {input.bam} by name...'
        samtools sort -n \
        -@ {threads} \
        -o {output.sorted_bam} \
        {input.bam} \
        &> {log}
        '''

rule bam_to_fastq:
    input: 
        sorted_bam=f'{RESULTS_VIRUS_DIR}/sort/{{sample}}_sorted.bam',
    output:
        R1=f'{RESULTS_VIRUS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{RESULTS_VIRUS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    threads: 
        config['threads']['samtools']
    log:
        f'{LOGS_VIRUS_DIR}/samtools/fastq/{{sample}}_bam_to_fastq.log'
    shell:
        '''
        echo 'Extracting FASTQ files from {input.sorted_bam}...'
        samtools fastq \
        -@ {threads} \
        -1 {output.R1} \
        -2 {output.R2} \
        {input.sorted_bam} \
        &> {log}
        '''

rule fastqc_virus:
    input:
        R1=f'{RESULTS_VIRUS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{RESULTS_VIRUS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        R1=multiext(f'{RESULTS_VIRUS_DIR}/fastqc/{{sample}}_R1_fastqc','.html','.zip'),
        R2=multiext(f'{RESULTS_VIRUS_DIR}/fastqc/{{sample}}_R2_fastqc','.html','.zip')
    threads:
        config['threads']['fastqc']
    log:
        f'{LOGS_VIRUS_DIR}/fastqc/{{sample}}_fastqc_virus.log'
    params:
        out_dir=f'{RESULTS_VIRUS_DIR}/fastqc'
    shell:
        '''
        echo 'Running a quality control report for {input.R1} and {input.R2}...'
        fastqc -o {params.out_dir} \
         -t {threads} \
         {input.R1} \
         {input.R2} \
         &> {log}
        '''
