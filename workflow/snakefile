import os
import sys
import errno
import pandas as pd

###########################
###### CONFIGURATION ######
###########################
configfile: 'config/config.yaml'

PROJECT = config['project']['name']
SPECIES = config['run']['ref_species']
BUILD = config['run']['ref_build']
RELEASE = config['run']['ref_release']

# Directory declaration and creation
DATA_DIR = os.path.join(config['path']['data_dir'], PROJECT) 
VSV_DIR = os.path.join(config['path']['data_dir'], config['path']['reference_dir'], 'VSV_GCF_000850045.1')
REF_DIR = os.path.join(config['path']['data_dir'], config['path']['reference_dir'], f'{SPECIES}_{BUILD}_{RELEASE}')

RUN_DIR = os.path.join(config['path']['run_dir'], config['run']['run_name'])
RESULTS_DIR = os.path.join(RUN_DIR, config['path']['results_dir'])
REPORT_DIR = os.path.join(RUN_DIR, config['path']['report_dir'])
LOGS_DIR = os.path.join(RUN_DIR, config['path']['log_dir'])
IGV_DIR = os.path.join(RUN_DIR, 'igv')
VIRUS_DIR = os.path.join(RUN_DIR, 'virus')

dirs = [DATA_DIR, VSV_DIR, REF_DIR, RESULTS_DIR, REPORT_DIR, LOGS_DIR, IGV_DIR, VIRUS_DIR]
for directory in dirs:
    os.makedirs(directory,exist_ok=True)
    print(f'Project directory \'{directory}\' created successfully', file=sys.stderr)

FASTA = os.path.join(REF_DIR, config['ref']['fasta'])
GTF   = os.path.join(REF_DIR, config['ref']['gtf'])
CDNA  = os.path.join(REF_DIR, config['ref']['cdna'])
VSV_FASTA = os.path.join(VSV_DIR, 'GCF_000850045.1_ViralProj14673_genomic.fa')
VSV_GTF   = os.path.join(VSV_DIR, 'genomic.gtf')

# File declaration and checks
SAMPLE_SHEET = os.path.join(DATA_DIR, config['run']['sample_sheet'])
if os.path.exists(SAMPLE_SHEET):
    print(f'File \'{SAMPLE_SHEET}\' located successfully', file=sys.stderr)
else:
    raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), SAMPLE_SHEET)
         
# Identifying samples from sample sheet and data directory
samples_df = pd.read_csv(SAMPLE_SHEET, sep = ',')
sample_sheet = samples_df['sample_id'].tolist()
sample_data = glob_wildcards(f'{DATA_DIR}/{{sample}}.cram').sample

if len(sample_sheet) > 0:
    print(f'{len(sample_sheet)} samples found in sample sheet ({SAMPLE_SHEET}):', file=sys.stderr)
    for sample in sample_sheet:
        print(f'- {sample}', file=sys.stderr)
else:
    raise ValueError(f'No samples found in sample sheet ({SAMPLE_SHEET})')

if len(sample_data) > 0:
    print(f'{len(sample_data)} samples found in data directory ({DATA_DIR}):', file=sys.stderr)
    for sample in sample_data:
        print(f'- {sample}', file=sys.stderr)
else:
    raise ValueError('No samples found in sample sheet')

SAMPLES = (set(sample_sheet) & set(sample_data)) # samples present in both locations
MISSING = sorted(set(sample_sheet) - set(sample_data)) # samples listed in sample sheet but missing from data directory

if MISSING:
    print(f'WARNING: {len(MISSING)} samples from the sample sheet ({SAMPLE_SHEET} were not found in data directory ({DATA_DIR}):', file=sys.stderr)
    for sample in MISSING:
        print(f'- {sample}', file=sys.stderr)

print(f'Found {len(SAMPLES)} valid samples:', file=sys.stderr)
for sample in SAMPLES:
        print(f'- {sample}', file=sys.stderr)

print(f'Running analysis of {len(SAMPLES)} RNA-seq samples for {PROJECT} project. \nSpecies: {SPECIES} \nBuild: {BUILD} \nRelease: {RELEASE}', file=sys.stderr)

# Declaring desired outputs for the pipeline
rule all:
    input: 
        report=f'{REPORT_DIR}/multiqc_report.html',
        coord_sorted_bams=expand(f'{IGV_DIR}/{{sample}}_coord_sorted.bam', sample=SAMPLES),
        bam_indices=expand(f'{IGV_DIR}/{{sample}}_coord_sorted.bam.bai', sample=SAMPLES),
        unmapped_bam=expand(f'{VIRUS_DIR}/unmapped/{{sample}}_unmapped.bam', sample=SAMPLES),
        viral_bams=expand(f'{VIRUS_DIR}/sort/{{sample}}_sorted_viral.bam', sample=SAMPLES),
        viral_counts=f'{RESULTS_DIR}/featurecounts/counts_viral.txt'

###########################
##### QUALITY CONTROL #####
###########################
rule flagstat:
    input: 
        cram=f'{DATA_DIR}/{{sample}}.cram'
    output: 
        txt=f'{RESULTS_DIR}/flagstat/pre_align/{{sample}}.txt'
    shell:
        '''
        echo 'Running samtools flagstat on {input.cram}...'
        samtools flagstat {input.cram} > {output.txt}
        '''

rule sort_cram:
    input:
        cram=f'{DATA_DIR}/{{sample}}.cram'
    output:
        sorted_cram=temp(f'{RESULTS_DIR}/sort/{{sample}}.cram')
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools_sort/{{sample}}_sort.log'
    shell:
        '''
        echo 'Sorting {input.cram} by name...'
        samtools sort -n \
        -@ {threads} \
        -o {output.sorted_cram} \
        {input.cram} \
        &> {log}
        '''

rule cram_to_fastq:
    input: 
        sorted_cram=f'{RESULTS_DIR}/sort/{{sample}}.cram',
    output:
        R1=f'{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    threads: 
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/fastq/{{sample}}_fastq.log'
    shell:
        '''
        echo 'Extracting FASTQ files from {input.sorted_cram}...'
        samtools fastq \
        -@ {threads} \
        -1 {output.R1} \
        -2 {output.R2} \
        {input.sorted_cram} \
        &> {log}
        '''

rule fastqc:
    input:
        R1=f'{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        R1=multiext(f'{RESULTS_DIR}/fastqc/pre_trim/{{sample}}_R1_fastqc','.html','.zip'),
        R2=multiext(f'{RESULTS_DIR}/fastqc/pre_trim/{{sample}}_R2_fastqc','.html','.zip')
    threads:
        config['threads']['fastqc']
    log:
        f'{LOGS_DIR}/fastqc/pre_trim/{{sample}}_fastqc.log'
    params:
        out_dir=f'{RESULTS_DIR}/fastqc/pre_trim'
    shell:
        '''
        echo 'Running a quality control report for {input.R1} and {input.R2}...'
        fastqc -o {params.out_dir} \
         -t {threads} \
         {input.R1} \
         {input.R2} \
         &> {log}
        '''

rule fastp_trim:
    input:
        R1=f'{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        trimmed_R1=f'{RESULTS_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz',
        trimmed_R2=f'{RESULTS_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz',
        html=f'{RESULTS_DIR}/fastp/{{sample}}.html',
        json=f'{RESULTS_DIR}/fastp/{{sample}}.json'
    threads:
        config['threads']['fastp']
    log:
        f'{LOGS_DIR}/fastp/{{sample}}_fastp.log'
    shell:
        '''
        echo 'Trimming reads for {input.R1} and {input.R2}...'
        fastp -V \
        --thread {threads} \
         -o {output.trimmed_R1} \
         -O {output.trimmed_R2} \
         -i {input.R1} \
         -I {input.R2} \
         --detect_adapter_for_pe \
         -h {output.html} \
         -j {output.json} \
         &> {log}
        '''

rule fastqc_trimmed:
    input:
        R1=f'{RESULTS_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz',
        R2=f'{RESULTS_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz'
    output:
        R1=multiext(f'{RESULTS_DIR}/fastqc/post_trim/{{sample}}_R1_trimmed_fastqc','.html','.zip'),
        R2=multiext(f'{RESULTS_DIR}/fastqc/post_trim/{{sample}}_R2_trimmed_fastqc','.html','.zip')
    threads:
        config['threads']['fastqc']
    log:
        f'{LOGS_DIR}/fastqc/post_trim/{{sample}}_fastqc_trimmed.log'
    params:
        out_dir=f'{RESULTS_DIR}/fastqc/post_trim'
    shell:
        '''
        echo 'Running a quality control report for {input.R1} and {input.R2}...'
        fastqc -o {params.out_dir} \
         -t {threads} \
         {input.R1} \
         {input.R2} \
         &> {log}
        '''

###########################
######## ALIGNMENT ########
###########################
rule hisat2_index:
    input: 
        fasta=FASTA
    output: 
        multiext(
            FASTA,
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2')
    threads:
        config['threads']['hisat2']
    params:
        index_base=f'{FASTA}'
    log:
        f'{LOGS_DIR}/hisat2/index.log'
    shell:
        '''
        echo 'Building hisat2 index for {input.fasta}...'
        hisat2-build  --threads {threads} \
        {input.fasta} \
        {params.index_base} \
        &> {log}
        '''

rule hisat2_align:
    input:
        multiext(
            FASTA,
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2'),
        trimmed_R1=f'{RESULTS_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz',
        trimmed_R2=f'{RESULTS_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz',
    threads:
        config['threads']['hisat2']
    output:
        sam=temp(f'{RESULTS_DIR}/hisat2/{{sample}}.sam')
    log:
        f'{LOGS_DIR}/hisat2/{{sample}}_align.log'
    params:
        index_base=f'{FASTA}'
    shell:
        '''
        echo 'Running HISAT2 alignment for {input.trimmed_R1} and {input.trimmed_R2}'
        hisat2 -x {params.index_base} \
        --threads {threads} \
        -1 {input.trimmed_R1} \
        -2 {input.trimmed_R2} \
        -S {output.sam} \
        &> {log}
        '''

rule sort_bam:
    input:
        sam=f'{RESULTS_DIR}/hisat2/{{sample}}.sam'
    output:
        sorted_bam=f'{RESULTS_DIR}/sort/{{sample}}_sorted.bam'
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools_sort/{{sample}}_sortbam.log'
    shell:
        '''
        echo 'Sorting {input.sam} by name...'
        samtools sort -n \
        -@ {threads} \
        {input.sam} \
        -o {output.sorted_bam} \
        &> {log}
        '''

rule flagstat_aligned:
    input: 
        sorted_bam=f'{RESULTS_DIR}/sort/{{sample}}_sorted.bam'
    output: 
        txt=f'{RESULTS_DIR}/flagstat/post_align/{{sample}}_aligned.txt'
    shell:
        '''
        echo 'Running samtools flagstat on {input.sorted_bam}...'
        samtools flagstat {input.sorted_bam} > {output.txt}
        '''

rule feature_counts:
    input:
        bams=expand(f'{RESULTS_DIR}/sort/{{sample}}_sorted.bam', sample=SAMPLES),
        gtf=GTF
    output:
        counts=f'{RESULTS_DIR}/featurecounts/counts.txt'
    threads:
        config['threads']['featurecounts']
    log:
        f'{LOGS_DIR}/featurecounts/featurecounts.log'
    shell:
        '''
        echo 'Running featureCounts for {input.bams}...'
        featureCounts -p \
        -g gene_id \
        -a {input.gtf} \
        -o {output.counts} \
        -T {threads} \
        {input.bams} \
        &> {log}
        '''

###########################
########### IGV ###########
###########################
rule coord_sort_bam:
    input:
        bam=f'{RESULTS_DIR}/sort/{{sample}}_sorted.bam'
    output:
        sorted_bam=f'{IGV_DIR}/{{sample}}_coord_sorted.bam'
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools_sort/{{sample}}_coordsort.log'
    shell:
        '''
        echo 'Sorting {input.bam} by coordinate...'
        samtools sort -@ {threads} \
        -o {output.sorted_bam} \
        {input.bam} \
        &> {log}
        '''

rule index_bam:
    input:
        bam=f'{IGV_DIR}/{{sample}}_coord_sorted.bam'
    output:
        bai=f'{IGV_DIR}/{{sample}}_coord_sorted.bam.bai'
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools_index/{{sample}}_index.log'
    shell:
        '''
        echo 'Indexing {input.bam}...'
        samtools index -@ {threads} \
        {input.bam} \
        &> {log}
        '''

###########################
##### VIRAL DETECTION #####
###########################
rule extract_unmapped_reads:
    input:
        bam=f'{RESULTS_DIR}/sort/{{sample}}_sorted.bam'
    output:
        unmapped_bam=f'{VIRUS_DIR}/unmapped/{{sample}}_unmapped.bam'
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools_extract/{{sample}}_extract.log'
    shell:
        '''
        echo 'Extracting unmapped reads from {input.bam}...'
        samtools view -b -f 12 \
        -@ {threads} \
        {input.bam} \
        > {output.unmapped_bam} \
        &> {log}
        '''

rule name_sort_viral_bam:
    input:
        bam=f'{VIRUS_DIR}/unmapped/{{sample}}_unmapped.bam'
    output:
        sorted_bam=temp(f'{VIRUS_DIR}/sort/{{sample}}_sorted_viral.bam')
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools_sort/{{sample}}_name_sort_viral.log'
    shell:
        '''
        echo 'Sorting {input.bam} by name...'
        samtools sort -n \
        -@ {threads} \
        -o {output.sorted_bam} \
        {input.bam} \
        &> {log}
        '''

rule bam_to_fastq:
    input: 
        sorted_bam=f'{VIRUS_DIR}/sort/{{sample}}_sorted_viral.bam',
    output:
        R1=f'{VIRUS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{VIRUS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    threads: 
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/fastq/{{sample}}_fastq.log'
    shell:
        '''
        echo 'Extracting FASTQ files from {input.sorted_bam}...'
        samtools fastq \
        -@ {threads} \
        -1 {output.R1} \
        -2 {output.R2} \
        {input.sorted_bam} \
        &> {log}
        '''

rule hisat2_index_viral:
    input: 
        fasta=VSV_FASTA
    output: 
        multiext(
            VSV_FASTA,
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2')
    threads:
        config['threads']['hisat2']
    params:
        index_base=f'{VSV_FASTA}'
    log:
        f'{LOGS_DIR}/hisat2/index_viral.log'
    shell:
        '''
        echo 'Building hisat2 index for {input.fasta}...'
        hisat2-build  --threads {threads} \
        {input.fasta} \
        {params.index_base} \
        &> {log}
        '''

rule align_viral:
    input: 
        multiext(
            VSV_FASTA,
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2'),
        R1=f'{VIRUS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        R2=f'{VIRUS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        sam=temp(f'{VIRUS_DIR}/hisat2/{{sample}}_virus_aligned.sam')
    threads:
        config['threads']['hisat2']
    log:
        f'{LOGS_DIR}/hisat2_virus/{{sample}}_virus_align.log'
    params:
        index_base=f'{VSV_FASTA}'
    shell:
        '''
        echo 'Aligning reads from {input.R1} and {input.R2} to viral reference...'
        hisat2 -x {params.index_base} \
        --threads {threads} \
        -1 {input.R1} \
        -2 {input.R2} \
        -S {output.sam} \
        &> {log}
        '''

rule sort_viral_bam:
    input:
        sam=f'{VIRUS_DIR}/hisat2/{{sample}}_virus_aligned.sam'
    output:
        sorted_bam=f'{VIRUS_DIR}/sort/{{sample}}_aligned_sorted_viral.bam'
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools_sort/{{sample}}_sortbam_viral.log'
    shell:
        '''
        echo 'Sorting {input.sam} by name...'
        samtools sort -n \
        -@ {threads} \
        {input.sam} \
        -o {output.sorted_bam} \
        &> {log}
        '''
rule feature_counts_viral:
    input:
        bams=expand(f'{VIRUS_DIR}/sort/{{sample}}_aligned_sorted_viral.bam', sample=SAMPLES),
        gtf=VSV_GTF
    output:
        counts=f'{RESULTS_DIR}/featurecounts/counts_viral.txt'
    threads:
        config['threads']['featurecounts']
    log:
        f'{LOGS_DIR}/featurecounts/featurecounts_viral.log'
    shell:
        '''
        echo 'Running featureCounts for {input.bams}...'
        featureCounts -p \
        -g gene_id \
        -a {input.gtf} \
        -o {output.counts} \
        -T {threads} \
        {input.bams} \
        &> {log}
        '''
        
###########################
######### REPORT ##########
###########################
rule multiqc:
    input:
        flagstat=expand(f'{RESULTS_DIR}/flagstat/pre_align/{{sample}}.txt', sample=SAMPLES),
        flagstat_aligned=expand(f'{RESULTS_DIR}/flagstat/post_align/{{sample}}_aligned.txt', sample=SAMPLES),
        fastqc=expand(f'{RESULTS_DIR}/fastqc/pre_trim/{{sample}}_{{read}}_fastqc.{{ext}}', sample=SAMPLES, read=['R1', 'R2'], ext=['html', 'zip']),
        fastqc_trimmed=expand(f'{RESULTS_DIR}/fastqc/post_trim/{{sample}}_{{read}}_trimmed_fastqc.{{ext}}', sample=SAMPLES, read=['R1', 'R2'], ext=['html', 'zip']),
        featurecounts=f'{RESULTS_DIR}/featurecounts/counts.txt'
        #kallisto=expand(f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv', sample=SAMPLES)
    output:
        html=f'{REPORT_DIR}/multiqc_report.html'
    log:
        f'{LOGS_DIR}/multiqc.log'
    params:
        fastqc_ignore=f'{LOGS_DIR}/fastqc/pre_trim/*',
        flagstat_ignore=f'{RESULTS_DIR}/flagstat/pre_align/*'
    shell:
        '''
        multiqc {RESULTS_DIR} \
        {LOGS_DIR} \
        --ignore {params.fastqc_ignore} \
        --ignore {params.flagstat_ignore} \
        -o {REPORT_DIR} \
        &> {log}
        '''