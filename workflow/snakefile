import os
import errno
import pandas as pd

###########################
###### CONFIGURATION ######
###########################
configfile: 'config/config.yaml'

PROJECT = config['project']['name']
SPECIES = config['run']['ref_species']
BUILD = config['run']['ref_build']
RELEASE = config['run']['ref_release']

# Directory declaration and creation
DATA_DIR = os.path.join(config['path']['raw_data_dir'], PROJECT) 
RESULTS_DIR = os.path.join(config['path']['results_dir'], PROJECT)
REPORT_DIR = os.path.join(config['path']['report_dir'], PROJECT)
REF_DIR = os.path.join(config['path']['reference_dir'], SPECIES, f'release-{RELEASE}_BUILD')
dirs = [DATA_DIR, RESULTS_DIR, REPORT_DIR, REF_DIR]
for dir in dirs:
    os.makedirs(dir,exist_ok=True)
    print(f'Project directory \'{dir}\' created successfully')

# File declaration and checks
SAMPLE_SHEET = os.path.join(DATA_DIR, config['run']['sample_sheet'])
if os.path.exists(SAMPLE_SHEET)
    print(f'File \'{SAMPLE_SHEET}\' located successfully')
else:
    raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), file)
         
# Identifying samples from sample sheet and data directory
samples_df = pd.read_csv(SAMPLE_SHEET, sep = ',')
sample_sheet = samples_df['sample_id'].tolist()
sample_data = glob_wildcards(f'{DATA_DIR}/{{sample}}.cram').sample

if len(sample_sheet) > 0:
    print(f'{len(sample_sheet)} samples found in sample sheet ({SAMPLE_SHEET}):')
    for sample in sample_sheet:
        print(f'- {sample}')
else:
    raise ValueError(f'No samples found in sample sheet ({SAMPLE_SHEET})')

if len(sample_data) > 0:
    print(f'{len(sample_data)} samples found in data directory ({DATA_DIR}):')
    for sample in sample_data:
        print(f'- {sample}')
else:
    raise ValueError('No samples found in sample sheet')

SAMPLES = (set(sample_sheet) & set(sample_data)) # samples present in both locations
MISSING = sorted(set(sample_sheet) - set(sample_data)) # samples listed in sample sheet but missing from data directory

if MISSING:
    print(f'WARNING: {len(MISSING)} samples from the sample sheet ({SAMPLE_SHEET} were not found in data directory ({DATA_DIR}):')
    for sample in MISSING:
        print(f'- {sample}')

print(f'Found {len(SAMPLES)} valid samples:')
for sample in SAMPLES:
        print(f'- {sample}')

# Declaring desired outputs for the pipeline
rule all:
    input: 
        expand(f'{RESULTS_DIR}/qc/flagstat/{{sample}}.txt', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/qc/fastqc/{{sample}}_R1_fastqc.html', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/qc/fastqc/{{sample}}_R2_fastqc.html', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/qc/fastp/{{sample}}.json', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv', sample=SAMPLES), #*
        f'{REPORT_DIR}/multiqc_report.html' #*
        
###########################
###### DATA DOWNLOAD ######
###########################
rule get_cdna:
    output: 
        f'{REF_DIR}/{SPECIES}.{BUILD}.cdna.all.fa.gz'
    shell:
        '''
        wget -P {REF_DIR} 'http://ftp.ensembl.org/pub/release-{RELEASE}/fasta/{SPECIES}/cdna/{SPECIES}.{BUILD}.cdna.all.fa.gz'
        '''

rule get_genome:
    output: 
        f'{REF_DIR}/{SPECIES}.{BUILD}.dna.toplevel.fa.gz'
        f'{REF_DIR}/{SPECIES}.{BUILD}.dna.toplevel.fa.gz.fai'
    shell:
        '''
        wget -P {REF_DIR} 'http://ftp.ensembl.org/pub/release-{RELEASE}/fasta/{SPECIES}/dna_index/{SPECIES}.{BUILD}.dna.toplevel.fa.gz'
        wget -P {REF_DIR}'http://ftp.ensembl.org/pub/release-{RELEASE}/fasta/{SPECIES}/dna_index/{SPECIES}.{BUILD}.dna.toplevel.fa.gz.fai'
        '''

rule get_annotation:
    output: f'{REF_DIR}/{SPECIES}.{BUILD}.{RELEASE}.gtf.gz'
    shell:
        '''
        wget -P {REF_DIR} 'http://ftp.ensembl.org/pub/release-{RELEASE}/gtf/{SPECIES}/{SPECIES}.{BUILD}.{RELEASE}.gtf.gz'
        '''

rule kallisto_index:
    input: 
        fasta=f'{REF_DIR}/{SPECIES}.{BUILD}.cdna.all.fa.gz'
    output: 
        idx=f'{REF_DIR}/{SPECIES}.{BUILD}.idx'
    threads:
        config['kallisto']['threads']
    log:
        f'{RESULTS_DIR}/logs/kallisto/kallistoindex.log'
    shell:
        '''
        echo 'Building kallisto index for {input.fasta}...'
        kallisto index -i {output.idx} {input.fasta} -t {threads} &> {log}
        '''

###########################
## QUALITY CONTROL RULES ##
###########################
rule flagstat:
    input: 
        cram=f'{DATA_DIR}/{{sample}}.cram',
    output: 
        txt=f'{RESULTS_DIR}/qc/flagstat/{{sample}}.txt'
    shell:
        '''
        echo 'Running samtools flagstat on {input.cram}...'
        samtools flagstat {input.cram} > {output.txt}
        '''

rule sort:
    input:
        cram=f'{DATA_DIR}/{{sample}}.cram',
    output:
        sorted_cram=temp(f'{RESULTS_DIR}/sort/{{sample}}.cram')
    threads:
        config['samtools']['threads']
    log:
        f'{RESULTS_DIR}/logs/sort/{{sample}}_samtoolssort.log'
    shell:
        '''
        echo 'Sorting {input.cram} by name...'
        samtools sort -n -o {output.sorted_cram} {input.cram} &> {log}
        '''

rule fastq:
    input: 
        sorted_cram=f'{RESULTS_DIR}/sort/{{sample}}.cram',
    output:
        read1=temp(f'{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz'),
        read2=temp(f'{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz'),
    threads: 
        config['fastq']['threads']
    log:
        f'{RESULTS_DIR}/logs/fastq/{{sample}}_fastq.log'
    shell:
        '''
        echo 'Extracting FASTQ files from {input.sorted_cram}...'
        samtools fastq -@ {threads} -1 {output.read1} -2 {output.read2} {input.sorted_cram} &> {log}
        '''

rule fastqc:
    input:
        read1=f'{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        read2=f'{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        html1=f'{RESULTS_DIR}/qc/fastqc/{{sample}}_R1_fastqc.html',
        html2=f'{RESULTS_DIR}/qc/fastqc/{{sample}}_R2_fastqc.html',
        zip1=f'{RESULTS_DIR}/qc/fastqc/{{sample}}_R1_fastqc.zip',
        zip2=f'{RESULTS_DIR}/qc/fastqc/{{sample}}_R2_fastqc.zip',
    threads:
        config['fastqc']['threads']
    log:
        f'{RESULTS_DIR}/logs/fastqc/{{sample}}_fastqc.log'
    shell:
        '''
        echo 'Running a quality control report for {input.read1} and {input.read2}...'
        fastqc -o {RESULTS_DIR}/qc/fastqc -t {threads} {input.read1} {input.read2} &> {log}
        '''

rule fastp:
    input:
        read1=f'{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        read2=f'{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        trimmed_read1=temp(f'{RESULTS_DIR}/qc/fastp/{{sample}}_R1_trimmed.fastq.gz'),
        trimmed_read2=temp(f'{RESULTS_DIR}/qc/fastp/{{sample}}_R2_trimmed.fastq.gz'),
        html=f'{RESULTS_DIR}/qc/fastp/{{sample}}.html',
        json=f'{RESULTS_DIR}/qc/fastp/{{sample}}.json'
    threads:
        config['fastp']['threads']
    log:
        f'{RESULTS_DIR}/logs/fastp/{{sample}}_fastp.log'
    shell:
        '''
        echo 'Trimming reads for {input.read1} and {input.read2}...'
        fastp -V --thread {threads} -o {output.trimmed_read1} -O {output.trimmed_read2} -i {input.read1} -I {input.read2} -h {output.html} -j {output.json} &> {log}
        '''

###########################
##### PSEUDOALIGNMENT #####
###########################

rule kallisto_quant:
    input:
        idx=f'{REF_DIR}/{SPECIES}.{BUILD}.idx',
        trimmed_read1=f'{RESULTS_DIR}/qc/fastp/{{sample}}_R1_trimmed.fastq.gz',
        trimmed_read2=f'{RESULTS_DIR}/qc/fastp/{{sample}}_R2_trimmed.fastq.gz',
    params:
        out_dir=f'{RESULTS_DIR}/kallisto/{{sample}}',
        sample='{sample}'
    output:
        tsv=f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv',
        h5=f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.h5',
        json=f'{RESULTS_DIR}/kallisto/{{sample}}/run_info.json'
    log: 
        f'{RESULTS_DIR}/logs/kallisto/{{sample}}_kallistoquant.log'
    threads:
        config['kallisto']['threads']
    shell:
        '''
        echo 'Running kallisto pseudoalignment for {input.trimmed_read1} and {input.trimmed_read2}'
        kallisto quant -i {input.idx} -o {params.out_dir} -t {threads} {input.trimmed_read1} {input.trimmed_read2} &> {log}
        '''

###########################
######### REPORT ##########
###########################
rule multiqc:
    input:
        expand(f'{RESULTS_DIR}/qc/flagstat/{{sample}}.txt', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/qc/fastqc/{{sample}}_R1_fastqc.zip', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/qc/fastqc/{{sample}}_R2_fastqc.zip', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/qc/fastp/{{sample}}.json', sample = SAMPLES),
        expand(f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/logs/kallisto/{{sample}}_kallistoquant.log', sample=SAMPLES)
    output:
        html=f'{REPORT_DIR}/multiqc_report.html'
    log: 
        f'{RESULTS_DIR}/logs/multiqc.log'
    shell:
        '''
        multiqc {DATA_DIR} {RESULTS_DIR} -o {REPORT_DIR} &> {log}
        '''