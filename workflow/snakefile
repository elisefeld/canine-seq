import os
import errno
import pandas as pd

###########################
###### CONFIGURATION ######
###########################
configfile: 'config/config.yaml'

PROJECT = config['project']['name']
SPECIES = config['run']['ref_species']
BUILD = config['run']['ref_build']
RELEASE = config['run']['ref_release']

FASTA = config['ref']['fasta']
GTF = config['ref']['gtf']

# Directory declaration and creation
DATA_DIR = os.path.join(config['path']['data_dir'], PROJECT) 
REF_DIR = os.path.join(config['path']['data_dir'], config['path']['reference_dir'], f'{SPECIES}_{BUILD}_{RELEASE}')

RUN_DIR = os.path.join(config['path']['run_dir'], config['run']['run_name'])
RESULTS_DIR = os.path.join(RUN_DIR, config['path']['results_dir'])
REPORT_DIR = os.path.join(RUN_DIR, config['path']['report_dir'])
LOGS_DIR = os.path.join(RUN_DIR, config['path']['log_dir'])

dirs = [DATA_DIR, REF_DIR, RESULTS_DIR, REPORT_DIR, LOGS_DIR]
for dir in dirs:
    os.makedirs(dir,exist_ok=True)
    print(f'Project directory \'{dir}\' created successfully')

# File declaration and checks
SAMPLE_SHEET = os.path.join(DATA_DIR, config['run']['sample_sheet'])
if os.path.exists(SAMPLE_SHEET):
    print(f'File \'{SAMPLE_SHEET}\' located successfully')
else:
    raise FileNotFoundError(errno.ENOENT, os.strerror(errno.ENOENT), file)
         
# Identifying samples from sample sheet and data directory
samples_df = pd.read_csv(SAMPLE_SHEET, sep = ',')
sample_sheet = samples_df['sample_id'].tolist()
sample_data = glob_wildcards(f'{DATA_DIR}/{{sample}}.cram').sample

if len(sample_sheet) > 0:
    print(f'{len(sample_sheet)} samples found in sample sheet ({SAMPLE_SHEET}):')
    for sample in sample_sheet:
        print(f'- {sample}')
else:
    raise ValueError(f'No samples found in sample sheet ({SAMPLE_SHEET})')

if len(sample_data) > 0:
    print(f'{len(sample_data)} samples found in data directory ({DATA_DIR}):')
    for sample in sample_data:
        print(f'- {sample}')
else:
    raise ValueError('No samples found in sample sheet')

SAMPLES = (set(sample_sheet) & set(sample_data)) # samples present in both locations
MISSING = sorted(set(sample_sheet) - set(sample_data)) # samples listed in sample sheet but missing from data directory

if MISSING:
    print(f'WARNING: {len(MISSING)} samples from the sample sheet ({SAMPLE_SHEET} were not found in data directory ({DATA_DIR}):')
    for sample in MISSING:
        print(f'- {sample}')

print(f'Found {len(SAMPLES)} valid samples:')
for sample in SAMPLES:
        print(f'- {sample}')


print(f'Running analysis of {len(SAMPLES)} RNA-seq samples for {PROJECT} project. \nSpecies: {SPECIES} \nBuild: {BUILD} \nRelease: {RELEASE}')

# Declaring desired outputs for the pipeline
rule all:
    input: 
        expand(f'{RESULTS_DIR}/flagstat/{{sample}}.txt', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/flagstat/{{sample}}_aligned.txt', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/fastqc/{{sample}}_R1_fastqc.html', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/fastqc/{{sample}}_R2_fastqc.html', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/fastqc/{{sample}}_R1_fastqc_trimmed.html', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/fastqc/{{sample}}_R2_fastqc_trimmed.html', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/fastp/{{sample}}.json', sample=SAMPLES),
        #expand(f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv', sample=SAMPLES), #*
        expand(f'{RESULTS_DIR}/hisat2/{{sample}}_sorted.bam.bai', sample=SAMPLES),
        #f'{REPORT_DIR}/multiqc_report.html', #*

###########################
##### QUALITY CONTROL #####
###########################
rule flagstat:
    input: 
        cram=f'{DATA_DIR}/{{sample}}.cram'
    output: 
        txt=f'{RESULTS_DIR}/flagstat/{{sample}}.txt'
    shell:
        '''
        echo 'Running samtools flagstat on {input.cram}...'
        samtools flagstat {input.cram} > {output.txt}
        '''

rule cram_sort:
    input:
        cram=f'{DATA_DIR}/{{sample}}.cram'
    output:
        sorted_cram=temp(f'{RESULTS_DIR}/sort/{{sample}}.cram')
    threads:
        config['threads']['samtools']
    log:
        f'{LOGS_DIR}/samtools/{{sample}}_sort.log'
    shell:
        '''
        echo 'Sorting {input.cram} by name...'
        samtools sort -n \
        -o {output.sorted_cram} \
        {input.cram} \
        &> {log}
        '''

rule cram_to_fastq:
    input: 
        sorted_cram=f'{RESULTS_DIR}/sort/{{sample}}.cram',
    output:
        read1=temp(f'{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz'),
        read2=temp(f'{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz'),
    threads: 
        config['threads']['fastq']
    log:
        f'{LOGS_DIR}/fastq/{{sample}}_fastq.log'
    shell:
        '''
        echo 'Extracting FASTQ files from {input.sorted_cram}...'
        samtools fastq -@ {threads} \
        -1 {output.read1} \
        -2 {output.read2} \
        {input.sorted_cram} \
        &> {log}
        '''

rule fastqc:
    input:
        read1=f'{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        read2=f'{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        html1=f'{RESULTS_DIR}/fastqc/{{sample}}_R1_fastqc.html',
        html2=f'{RESULTS_DIR}/fastqc/{{sample}}_R2_fastqc.html',
        zip1=f'{RESULTS_DIR}/fastqc/{{sample}}_R1_fastqc.zip',
        zip2=f'{RESULTS_DIR}/fastqc/{{sample}}_R2_fastqc.zip'
    threads:
        config['threads']['fastqc']
    log:
        f'{LOGS_DIR}/fastqc/{{sample}}_fastqc.log'
    shell:
        '''
        echo 'Running a quality control report for {input.read1} and {input.read2}...'
        fastqc -o {RESULTS_DIR}/fastqc \
         -t {threads} \
         {input.read1} \
         {input.read2} \
         &> {log}
        '''

rule fastp_trim:
    input:
        read1=f'{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz',
        read2=f'{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz'
    output:
        trimmed_read1=f'{RESULTS_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz',
        trimmed_read2=f'{RESULTS_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz',
        html=f'{RESULTS_DIR}/fastp/{{sample}}.html',
        json=f'{RESULTS_DIR}/fastp/{{sample}}.json'
    threads:
        config['threads']['fastp']
    log:
        f'{LOGS_DIR}/fastp/{{sample}}_fastp.log'
    shell:
        '''
        echo 'Trimming reads for {input.read1} and {input.read2}...'
        fastp -V \
        --thread {threads} \
         -o {output.trimmed_read1} \
         -O {output.trimmed_read2} \
         -i {input.read1} \
         -I {input.read2} \
         -h {output.html} \
         -j {output.json} \
         &> {log}
        '''

rule fastqc_trimmed:
    input:
        read1=f'{RESULTS_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz',
        read2=f'{RESULTS_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz'
    output:
        html1=f'{RESULTS_DIR}/fastqc/{{sample}}_R1_fastqc_trimmed.html',
        html2=f'{RESULTS_DIR}/fastqc/{{sample}}_R2_fastqc_trimmed.html',
        zip1=f'{RESULTS_DIR}/fastqc/{{sample}}_R1_fastqc_trimmed.zip',
        zip2=f'{RESULTS_DIR}/fastqc/{{sample}}_R2_fastqc_trimmed.zip'
    threads:
        config['threads']['fastqc']
    log:
        f'{LOGS_DIR}/fastqc/{{sample}}_fastqc.log'
    shell:
        '''
        echo 'Running a quality control report for {input.read1} and {input.read2}...'
        fastqc -o {RESULTS_DIR}/fastqc \
         -t {threads} \
         {input.read1} \
         {input.read2} \
         &> {log}
        '''

###########################
##### PSEUDOALIGNMENT #####
###########################
rule kallisto_index:
    input: 
        fasta=f'{REF_DIR}/{FASTA}'
    output: 
        idx=f'{REF_DIR}/{FASTA}.idx'
    threads:
        config['threads']['kallisto']
    log:
        f'{LOGS_DIR}/kallisto/index.log'
    shell:
        '''
        echo 'Building kallisto index for {input.fasta}...'
        kallisto index -i {output.idx} \
         {input.fasta} \
         -t {threads} \
         &> {log}
        '''

rule kallisto_quant:
    input:
        idx=f'{REF_DIR}/{FASTA}.idx',
        trimmed_read1=f'{RESULTS_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz',
        trimmed_read2=f'{RESULTS_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz',
    params:
        out_dir=f'{RESULTS_DIR}/kallisto/{{sample}}',
        sample='{sample}'
    output:
        tsv=f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv',
        h5=f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.h5',
        json=f'{RESULTS_DIR}/kallisto/{{sample}}/run_info.json'
    log: 
        f'{LOGS_DIR}/kallisto/{{sample}}_quant.log'
    threads:
        config['threads']['kallisto']
    shell:
        '''
        echo 'Running kallisto pseudoalignment for {input.trimmed_read1} and {input.trimmed_read2}'
        kallisto quant -i {input.idx} \
         -o {params.out_dir} \
         -t {threads} \
         {input.trimmed_read1} \
         {input.trimmed_read2} \
         &> {log}
        '''


###########################
######## ALIGNMENT ########
###########################
rule hisat2_index:
    input: 
        fasta=f'{REF_DIR}/{FASTA}'
    output: 
        multiext(
            f'{REF_DIR}/{SPECIES}.{BUILD}',
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2')
    threads:
        config['threads']['hisat2']
    log:
        f'{LOGS_DIR}/hisat2/index.log'
    params:
        index_base=f"{REF_DIR}/{SPECIES}.{BUILD}"
    shell:
        '''
        echo 'Building hisat2 index for {input.fasta}...'
        hisat2-build  --threads {threads} \
        {input.fasta} \
        {params.index_base} \
        &> {log}
        '''

rule hisat2_align:
    input:
        multiext(
            f'{REF_DIR}/{SPECIES}.{BUILD}',
            '.1.ht2',
            '.2.ht2',
            '.3.ht2',
            '.4.ht2',
            '.5.ht2',
            '.6.ht2',
            '.7.ht2',
            '.8.ht2'),
        trimmed_read1=f'{RESULTS_DIR}/fastp/{{sample}}_R1_trimmed.fastq.gz',
        trimmed_read2=f'{RESULTS_DIR}/fastp/{{sample}}_R2_trimmed.fastq.gz',
    threads:
        config['threads']['hisat2']
    output:
        sam=f'{RESULTS_DIR}/hisat2/{{sample}}.sam'
    log:
        f'{LOGS_DIR}/hisat2/{{sample}}_align.log'
    params:
        index_base=f"{REF_DIR}/{SPECIES}.{BUILD}"
    shell:
        '''
        echo 'Running HISAT2 alignment for {input.trimmed_read1} and {input.trimmed_read2}'
        hisat2 -x {params.index_base} \
        --threads {threads} \
        -1 {input.trimmed_read1} \
        -2 {input.trimmed_read2} \
        -S {output.sam} \
        &> {log}
        '''

rule sort_bam:
    input:
        sam=f'{RESULTS_DIR}/hisat2/{{sample}}.sam'
    output:
        sorted_bam=f'{RESULTS_DIR}/bam/{{sample}}_sorted.bam'
    log:
        f'{LOGS_DIR}/samtools/{{sample}}_sortbam.log'
    shell:
        '''
        echo 'Sorting {input.sam} by name...'
        samtools sort -n \
        {input.sam} \
        -o {output.sorted_bam} \
        &> {log}
        '''

rule index_bam:
    input:
        sorted_bam=f'{RESULTS_DIR}/bam/{{sample}}_sorted.bam'
    output:
        bai=f'{RESULTS_DIR}/hisat2/{{sample}}_sorted.bam.bai'
    log:
        f'{LOGS_DIR}/samtools/{{sample}}_indexbam.log'
    shell:
        '''
        echo 'Creating index for {input.sorted_bam}...'
        samtools index {input.sorted_bam} \
        &> {log}
        '''

rule flagstat_aligned:
    input: 
        sorted_bam=f'{RESULTS_DIR}/bam/{{sample}}_sorted.bam'
    output: 
        txt=f'{RESULTS_DIR}/flagstat/{{sample}}_aligned.txt'
    shell:
        '''
        echo 'Running samtools flagstat on {input.sorted_bam}...'
        samtools flagstat {input.sorted_bam} > {output.txt}
        '''

rule feature_counts:
    input:
        bam=f'{RESULTS_DIR}/bam/{{sample}}_sorted.bam'
        gtf=f'{REF_DIR}/{GTF}'
    output:
        counts=f'{RESULTS_DIR}/featurecounts/{{sample}}_counts.txt'
   threads:
        config['threads']['featurecounts']
    log:
        f'{LOGS_DIR}/featurecounts/{{sample}}_featurecounts.log'
    shell:
        '''
        echo 'Running featureCounts for {input.bam}...'
        featureCounts -p \
        -g gene_id \
        -a {input.gtf} \
        -o {output.counts} \
        -T {threads} \
        {input.bam} \
        &> {log}
        '''

###########################
######### REPORT ##########
###########################
rule multiqc:
    input:
        expand(f'{RESULTS_DIR}/flagstat/{{sample}}.txt', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/flagstat/{{sample}}_aligned.txt', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/fastqc/{{sample}}_R1_fastqc.zip', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/fastqc/{{sample}}_R2_fastqc.zip', sample=SAMPLES),
        expand(f'{RESULTS_DIR}/fastp/{{sample}}.json', sample = SAMPLES),
        expand(f'{RESULTS_DIR}/bam/{{sample}}_sorted.bam.bai', sample=SAMPLES)
        #expand(f'{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv', sample=SAMPLES),
        #expand(f'{LOGS_DIR}/kallisto/{{sample}}_quant.log', sample=SAMPLES),
    output:
        html=f'{REPORT_DIR}/multiqc_report.html'
    log: 
        f'{LOGS_DIR}/multiqc.log'
    shell:
        '''
        multiqc {DATA_DIR} \
        {RESULTS_DIR} \
        -o {REPORT_DIR} \
        &> {log}
        '''