###########################
##### PSEUDOALIGNMENT #####
###########################
rule kallisto_index:
    input: 
        fasta=f"{REF_DIR}/{CDNA_REF}"
    output: 
        idx=f"{REF_DIR}/{ORGANISM}_{BUILD}.idx"
    #conda: 
    #    "../config/env.yaml"
    shell:
        """
        echo "Building kallisto index for {input.fasta}..."
        kallisto index -i {output.idx} {input.fasta}
        """

rule kallisto_quant:
    input:
        idx=f"{REF_DIR}/{ORGANISM}_{BUILD}.idx",
        fastq1=f"{RESULTS_DIR}/fastq/{{sample}}_R1.fastq.gz",
        fastq2=f"{RESULTS_DIR}/fastq/{{sample}}_R2.fastq.gz"
    output:
        abundance=f"{RESULTS_DIR}/kallisto/{{sample}}/abundance.tsv"
    #conda:
    #    "../config/env.yaml"
    shell:
        """
        kallisto quant -i {input.idx} -o {RESULTS_DIR}/kallisto/{sample} -t {THREADS} {input.fastq1} {input.fastq2}
        """

###########################
######### REPORT ##########
###########################
rule multiqc:
    input:
        raw_dir={PROJECT_DATA_DIR},
        results_dir={RESULTS_DIR},
        out_dir={REPORT_DIR}
    output:
        html=f"{REPORT_DIR}/multiqc_report.html"

    shell:
        """
        multiqc {input.raw_dir} {input.results_dir} -o {input.out_dir}
        """